# Immutable release inherited by VIO images at build time.
BASE_IMAGE=ghcr.io/skymule-ai/mullet-ros2-base:v0.5.0

# Pin OPENVINS_REF to a full upstream commit SHA for reproducible builds.
OPENVINS_REPOSITORY=https://github.com/rpng/open_vins.git
OPENVINS_REF=69488123ed9362dd44b6f28e7f4680abbff1442b

# RealSense image run beside VIO at runtime (mullet-drivers). Pin an immutable
# release tag once the Jazzy driver image is validated on the Orin.
REALSENSE_IMAGE=ghcr.io/skymule-ai/mullet-drivers-realsense:main

# Local builds use this tag. CI replaces it with branch, SHA, and release tags.
OPENVINS_IMAGE=ghcr.io/skymule-ai/mullet-vio-openvins:local

ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

REALSENSE_CAMERA_NAMESPACE=uav0
REALSENSE_CAMERA_NAME=d435i
REALSENSE_TF_PREFIX=uav0/d435i
